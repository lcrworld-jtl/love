# 服务端口
PORT=3009

# 管理后台密码（必填，无默认值！不设置则管理后台不可用）
ADMIN_PASSWORD=

# 网易云音乐 API 地址（配合 NeteaseCloudMusicApi 使用）
# 留空或使用默认值，服务器会自动启动 NeteaseCloudMusicApi
# 如果使用 PM2 管理 NeteaseCloudMusicApi，请确认实际端口（如 4000）
NETEASE_API=http://127.0.0.1:3002

# 网易云歌单 ID（必填！否则无法获取歌曲列表）
# 获取方法：打开网易云音乐网页版，进入歌单页面，URL 中 /playlist?id= 后面的数字
# 例如：https://music.163.com/playlist?id=123456 中的 123456
PLAYLIST_ID=

# 站点域名（用于 SEO sitemap / robots.txt）
SITE_URL=http://localhost:3009
